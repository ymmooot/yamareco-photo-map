{
  "manifest_version": 3,
  "name": "ヤマレコ 写真位置マップ",
  "version": "1.0.0",
  "description": "ヤマレコの山行記録ページで、写真一覧の撮影時刻とGPX軌跡を突き合わせ、各写真がルート上のどこで撮られたかを地図に表示します。",
  "minimum_chrome_version": "111",
  "content_scripts": [
    {
      "matches": ["https://www.yamareco.com/modules/yamareco/detail-*.html*"],
      "js": ["content.js"],
      "css": ["content.css"],
      "world": "MAIN",
      "run_at": "document_idle"
    }
  ]
}
